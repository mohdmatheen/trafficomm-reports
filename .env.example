# Trafficomm Reporting Workspace - configuration (copy to .env and load with `set -a; . ./.env; set +a`)

# --- required in any shared/production environment ---
DATABASE_URL=postgresql+psycopg://trafficomm:CHANGE_ME@localhost:5432/trafficomm
SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_hex(32))"
STORAGE_DIR=/srv/trafficomm/storage        # private directory, not web-served
COOKIE_SECURE=1                            # 1 behind HTTPS

# --- AI (optional). Without a key the app runs with clearly labelled rule-based "AI mocked" behaviour.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- limits ---
MAX_UPLOAD_MB=50
MAX_UNCOMPRESSED_MB=300                    # zip-bomb guard for XLSX/PPTX/ZIP
MAX_ROWS_PER_SHEET=200000
MAX_COLS_PER_SHEET=250
DOWNLOAD_LINK_TTL_SECONDS=600
JOB_TIMEOUT_SECONDS=900
JOB_MEMORY_MB=6144
JOB_MAX_ATTEMPTS=3
RETENTION_DAYS=180
SOFFICE_BIN=soffice

# --- seed passwords (scripts/seed.py); dev defaults are used if unset ---
# SEED_ADMIN_PASSWORD=
# SEED_EMPLOYEE_PASSWORD=
# SEED_EMPLOYEE2_PASSWORD=
