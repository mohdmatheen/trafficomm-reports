# Trafficomm Reporting Workspace - configuration (copy to .env and load with `set -a; . ./.env; set +a`)

# --- required in any shared/production environment ---
DATABASE_URL=postgresql+psycopg://trafficomm:CHANGE_ME@localhost:5432/trafficomm
SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_hex(32))"
STORAGE_DIR=/srv/trafficomm/storage        # private directory, not web-served
COOKIE_SECURE=1                            # 1 behind HTTPS

# --- AI (optional). Without a key the app runs with clearly labelled rule-based "AI mocked" behaviour.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- limits ---
MAX_UPLOAD_MB=50
MAX_UNCOMPRESSED_MB=300                    # zip-bomb guard for XLSX/PPTX/ZIP
MAX_ROWS_PER_SHEET=200000
MAX_COLS_PER_SHEET=250
DOWNLOAD_LINK_TTL_SECONDS=600
JOB_TIMEOUT_SECONDS=900
JOB_MEMORY_MB=6144
JOB_MAX_ATTEMPTS=3
RETENTION_DAYS=180
SOFFICE_BIN=soffice

# --- seed passwords (scripts/seed.py); dev defaults are used if unset ---
# SEED_ADMIN_PASSWORD=
# SEED_EMPLOYEE_PASSWORD=
# SEED_EMPLOYEE2_PASSWORD=

# Sign in with Zoho (OAuth / OpenID Connect). Register a "Server-based Application" at
# https://api-console.zoho.com with redirect URI  <PUBLIC_BASE_URL>/auth/zoho/callback
PUBLIC_BASE_URL=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com   # change for another Zoho region, e.g. https://accounts.zoho.eu
ZOHO_ALLOWED_DOMAINS=trafficomm.com
# Always allowed in, and made admin, when they sign in with Zoho:
ZOHO_ADMIN_EMAILS=matheen.m@trafficomm.com
# 1 = any allowed-domain account gets in as an employee; 0 (default) = only people an admin granted access
ZOHO_AUTO_PROVISION=0
# Set to 0 to turn off email+password sign-in once Zoho sign-in works
PASSWORD_LOGIN=1
